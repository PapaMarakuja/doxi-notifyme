# Supabase (service role: só no servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Nuvemshop (mesmo app/token do doxi-affiliates)
NUVEMSHOP_USER_ID=
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_API_URL=https://api.nuvemshop.com.br/v1
# Client secret do app: valida a assinatura dos webhooks
NUVEMSHOP_CLIENT_SECRET=

# SMTP (Hostinger, igual ao doxi-affiliates)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Domínios da loja que podem chamar /api/subscribe (separados por vírgula)
ALLOWED_ORIGINS=https://doxiwear.com,https://www.doxiwear.com
# Vercel envia "Authorization: Bearer <CRON_SECRET>" no cron
CRON_SECRET=
